# Local-only application settings. No Docker or external services are required.
ENVIRONMENT=development
DEBUG=false
OCR_ENGINE=tesseract
VLM_ENABLED=false
GEMINI_API_KEY=
# Set these from the model's current provider pricing to enable cost estimates.
VLM_INPUT_COST_PER_MILLION=0
VLM_OUTPUT_COST_PER_MILLION=0

# Set either API_KEY, or all three JWT login settings, to protect the API.
API_KEY=
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET=

# For production, use a JSON list containing the deployed frontend URL.
# Example: CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Optional malware scanning hook (requires clamscan on PATH)
CLAMAV_ENABLED=false

# Supabase (free hosted Postgres + private Storage; no Docker required)
# Set STORAGE_BACKEND=supabase after running the Alembic migration.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
SOURCE_RETENTION_DAYS=30
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
# Set true on a single free Render API service to process jobs without a separate worker.
EMBEDDED_WORKER_ENABLED=false
