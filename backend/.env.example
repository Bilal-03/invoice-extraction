# Supabase is the only application database and file store.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=documents

PIPELINE_PROFILE=local-full
OCR_ENGINE=pp-structure-v3
PADDLE_DEVICE=cpu
DOCUMENT_PARSER=auto
VLM_ENABLED=true
VLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b
# Optional Intel-friendly llama.cpp server (OpenAI-compatible llama-server).
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_CPP_MODEL=local-model

# Set either API_KEY, or all three JWT login settings, to protect the API.
API_KEY=
API_KEY_TENANT_ID=local
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET=

# For production, use a JSON list containing the deployed frontend URL.
# Example: CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Optional malware scanning hook (requires clamscan on PATH)
CLAMAV_ENABLED=false

# Supabase retention and worker settings
SOURCE_RETENTION_DAYS=30
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
# Set true on a single free Render API service to process jobs without a separate worker.
EMBEDDED_WORKER_ENABLED=false

# OpenTelemetry. Set an OTLP/HTTP collector endpoint in staging/production.
TRACING_ENABLED=true
TRACING_SERVICE_NAME=invoice-intelligence-api
TRACING_OTLP_ENDPOINT=
TRACING_SAMPLE_RATE=1.0
